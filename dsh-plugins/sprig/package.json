{
  "name": "dsh-plugin-sprig",
  "version": "1.0.2",
  "description": "DSH client plugin: send selected conversation text to Sprig and get a source-aware explanation card.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thatwzzh/sprig.git",
    "directory": "dsh-plugins/sprig"
  },
  "homepage": "https://github.com/thatwzzh/sprig/tree/main/dsh-plugins/sprig",
  "bugs": {
    "url": "https://github.com/thatwzzh/sprig/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sprig",
    "selection",
    "explain",
    "macos"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-message-quotes"
      ]
    }
  },
  "main": "./index.js"
}
